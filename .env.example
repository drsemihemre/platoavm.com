# ---------------------------------------------------------------------------
# Form bildirimleri (ZORUNLU) — Google Workspace / Gmail SMTP
# ---------------------------------------------------------------------------
# İletişim ve kiralama formları bu hesap üzerinden e-posta gönderir.
# SMTP_PASS, Google hesabında üretilen "Uygulama Şifresi"dir: tam 16 küçük harf.
SMTP_USER=ornek@platoavm.com
SMTP_PASS=abcdefghijklmnop
# Formların düşeceği kutu (opsiyonel, varsayılan: yonetim@platoavm.com)
# FORM_TO_EMAIL=yonetim@platoavm.com
# Gönderen görünen adı (opsiyonel, varsayılan: "Plato AVM Web Sitesi")
# FORM_FROM_NAME=Plato AVM Web Sitesi

# ---------------------------------------------------------------------------
# Yönetim paneli (Vercel'de mutlaka değiştir!)
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
# Aşağıdakilerden BİRİ: hash tercih edilir (ortam değişkenini gören düz şifreyi
# okuyamaz). Hash üretmek için:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],12))" 'SIFRE'
# ADMIN_PASSWORD_HASH=$2b$12$...
ADMIN_PASSWORD=cok-gizli-bir-sifre
ADMIN_SESSION_SECRET=cok-uzun-bir-rastgele-string-en-az-32-karakter

# ---------------------------------------------------------------------------
# Form spam koruması (opsiyonel) — Cloudflare Turnstile
# ---------------------------------------------------------------------------
# Boş bırakılırsa bu katman devre dışı kalır; honeypot, doldurma süresi ve
# hız sınırı her hâlükârda çalışır. İkisi birlikte tanımlanmalıdır:
# anahtar üretimi: Cloudflare panel > Turnstile > Add widget
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# ---------------------------------------------------------------------------
# Analytics (opsiyonel) — Vercel Analytics ayrıca varsayılan olarak açıktır
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=platoavm.com

# ---------------------------------------------------------------------------
# Yerel geliştirme
# ---------------------------------------------------------------------------
# PLATO_DATA_DIR=/Users/drsemihemre/Documents/Claude/Projects/platoavm.com/site/data
